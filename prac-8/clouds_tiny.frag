precision highp float;uniform vec2 u_resolution,u_mouse;uniform float u_time;void main(){vec2 s=gl_FragCoord.xy/u_resolution.y,v=s-u_mouse/u_resolution.y;vec3 S=mix(vec3(1,.7,.4),vec3(1,.8,1),s.y),c=S;for(float z=.25;z<1.1;z+=.25){vec2 p=s*7.*(2.-z)+z*vec2(u_time*.1,9);float w=.5,d;for(float a=2.;a<7.;a++){w+=sin(p.x)*sin(p.y)/exp2(a);p=p*mat2(1.2,1,-1,1.6);}d=.5+.4*(w-z)-s.y-z*exp(-dot(v,v)*20.)*.3;c=mix(c,mix((1.-min(d*3.,1.)*vec3(.4,.5,.5))*(w+.3),S,.5-.4*z),clamp(d*9.,0.,1.));}gl_FragColor=vec4(c,1);}